# 服务端运行配置示例。复制为 /etc/short-drama-lab/app.env（0600）后填入真实值。
# 修改后需要 systemctl restart short-drama-lab 才会生效。

PORT=4328
NODE_ENV=production
TZ=Asia/Shanghai
NODE_OPTIONS=--max-old-space-size=448

# 模型网关：默认 Responses；只有 /chat/completions 的供应商改成 chat
ATELIER_PROTOCOL=chat
ATELIER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ATELIER_API_KEY=<gateway-key>
ATELIER_MODEL=qwen3-vl-plus
ATELIER_FALLBACK_MODEL=qwen3-vl-plus
ATELIER_CREATIVE_MODEL=qwen3-vl-plus
ATELIER_CREATIVE_FALLBACK_MODEL=qwen3-vl-plus
ATELIER_CHAT_MAX_TOKENS=16384
ATELIER_AGENT_MAX_OUTPUT_TOKENS=5200
ATELIER_VLM_TIMEOUT_MS=480000
ATELIER_AGENT_TIMEOUT_MS=180000

# Vidu：关键帧与图生视频
VIDU_API_KEY=<vidu-key>
VIDU_BASE_URL=https://api.vidu.cn

# 媒体工具
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# 反向代理部署：必须显式放行公网 Host，否则短剧接口只接受本机访问
DRAMA_ALLOWED_HOSTS=<your-domain>
DRAMA_PUBLIC_ORIGINS=https://<your-domain>

# 小规格机器的工作队列上限
DRAMA_MAX_PROJECTS=1
DRAMA_LLM_CONCURRENCY=2
DRAMA_IMAGE_CONCURRENCY=1
DRAMA_VIDEO_CONCURRENCY=2
